{
  "name": "spark-agent",
  "version": "0.1.0",
  "description": "A minimal open-source coding agent harness — agent loop + tools, OpenAI-compatible (DeepSeek / etc.)",
  "type": "module",
  "bin": {
    "spark-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "harness",
    "llm",
    "tool-calling",
    "openai-compatible",
    "deepseek"
  ],
  "author": "HazyStar",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HazyStar/spark-agent.git"
  },
  "bugs": {
    "url": "https://github.com/HazyStar/spark-agent/issues"
  },
  "homepage": "https://github.com/HazyStar/spark-agent#readme"
}
